@page "/books"
@inject IBookService BookService
@inject IJSRuntime js
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<h3 class="text-center mt-4"><i class="bi bi-book"></i> Books</h3>

<div class="d-flex justify-content-end mb-3">
    <button type="button" class="btn btn-primary" @onclick="AddBook"><i class="bi bi-plus-lg"></i> Add New Book</button>
</div>

@if (books == null)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!books.Any())
{
    <p class="text-center text-danger">❌ No books available.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Author</th>
                <th>Pages</th>
                <th>Price</th>
                <th>Publish Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in books)
            {
                <tr>
                    <td>@book.Id</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.Pages</td>
                    <td>@book.Price.ToString("C")</td>
                    <td>@book.CreationDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <button class="btn btn-warning btn-sm me-2" @onclick="() => EditBook(book.Id)"><i class="bi bi-pencil"></i> Edit</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteBook(book.Id)"><i class="bi bi-trash"></i> Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private AlertsHelpers _alerts;
    private List<Book> books = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _alerts = new AlertsHelpers(JSRuntime);
            books = await BookService.GetListBooks();
        }
        catch (Exception ex)
        {
            await js.InvokeAsync<bool>("confirm", ex.Message);
            //Console.WriteLine($"Error loading books: {ex.Message}");
        }
    }

    private void AddBook()
    {
        js.InvokeVoidAsync("console.log", "AddBook");
        Navigation.NavigateTo("/books/new-book");
    }

    private void EditBook(int id)
    {
        Navigation.NavigateTo($"/books/edit-book/{id}");
    }

    private async Task DeleteBook(int id)
    {
        bool confirmDelete = await _alerts.ShowConfirmationAlert("Confirmation","Are you sure you want to delete this book?");
        
        if (confirmDelete)
        {
            bool deleted = await BookService.DeleteBook(id);
            if (deleted)
            {
                books = await BookService.GetListBooks();
                StateHasChanged();
            }
        }
    }
}
